# Plantilla de variables de entorno. Copiar a `.env` y rellenar con valores reales.
# `.env` esta en .gitignore: NUNCA se suben credenciales al repositorio.
#
# El codigo lee estos nombres con os.environ y funciona sin ellos
# (OpenSky permite consultas anonimas, con limites menores).

# --- OpenSky Network (fuente SECUNDARIA) ------------------------------------
# OpenSky usa OAuth2 `client_credentials`: NO es usuario y contrasena. El
# client_id y el client_secret se piden en el panel de la cuenta de OpenSky.
#
# No hacen falta para el funcionamiento normal: la fuente primaria es ADS-B
# (adsb.lol / adsb.fi / adsbdb.com), que es abierta y no pide credenciales.
# OpenSky solo se usa para confirmar al dia siguiente lo ya deducido.
#
# NUNCA guardes un credentials.json en el repositorio: esta en .gitignore
# precisamente por eso.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Opcional ---------------------------------------------------------------
# URL del directo de Flightradar24 del aeropuerto de Lanzarote en YouTube.
# Si no se define se usa el valor por defecto de config.py.
LANZAROTE_STREAM_URL=
