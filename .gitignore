# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Entornos virtuales -----------------------------------------------------
.venv/
venv/
env/
.conda/

# --- Credenciales -----------------------------------------------------------
.env
*.env
!.env.example
credentials.json
*.credentials.json

# --- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
notebooks/**/*.nbconvert.ipynb

# --- Datos: no se publican los clips del stream -----------------------------
data/*
!data/README.md
!data/.gitkeep
!data/clips/
!data/frames/
!data/annotations/
!data/splits/
data/clips/*
data/frames/*
data/annotations/*
data/splits/*
!data/clips/.gitkeep
!data/frames/.gitkeep
!data/annotations/.gitkeep
!data/splits/.gitkeep

# --- Modelos entrenados (vocabularios BoW, SVM, pesos) ----------------------
models/*
!models/.gitkeep

# --- Fotos del tablero de calibracion ---------------------------------------
# Las fotos NO se versionan (unos 19 MB). Lo que si se versiona es el resultado
# de la calibracion, en calibration/results/: K, distorsion y RMS en .npz y
# .json, que es lo que necesita el informe. El .json documenta con que patron y
# cuantas fotos se obtuvo.
calibration/images/*
!calibration/images/.gitkeep

# --- Video ------------------------------------------------------------------
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.m3u8
*.ts

# --- Caches de yt-dlp -------------------------------------------------------
.cache/
yt-dlp-cache/
*.part
*.ytdl
*.info.json

# --- Sistema operativo ------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
._*

# --- Editores ---------------------------------------------------------------
.idea/
.vscode/
*.swp
